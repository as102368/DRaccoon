# ============================================================
# DRaccoon .gitignore
# 只入库源码；二进制、PyInstaller 运行时、第三方库、
# 用户隐私数据（Cookie/同步缓存/日志）一律排除
# ============================================================

# ===== Electron 运行时二进制 =====
DRaccoon.exe
*.exe
*.dll
*.pak
*.bin
*.dat
icudtl.dat
resources.pak
snapshot_blob.bin
v8_context_snapshot.bin
d3dcompiler_47.dll
libEGL.dll
libGLESv2.dll
ffmpeg.dll
locales/

# ===== PyInstaller 打包运行时 + 第三方库（非本项目源码）=====
dispatcher/dispatcher.exe
dispatcher/_internal/*
!dispatcher/_internal/backend/
!dispatcher/_internal/python/

# ===== 第三方参考代码副本（非本项目代码）=====
douyin-downloader-main11111/

# ===== 隐私与运行数据（绝不入库）=====
.cookies.json
cookies/
.sync/
*.log
debug.log
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
LICENSES.chromium.html
resources/default_app.asar

# ===== Python 缓存与生成物 =====
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# ===== 开发期临时探测/验证脚本（位于仓库根目录的一次性文件）=====
/_probe*.py
/_query_authors.py
/_run_bridge_probe.py
/_verify_*.py
/_mock_bridge*
/_bridge_probe_result.txt
/_final_state.txt
/_snap_like.png
*.zip
